{
  "name": "users",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/users/src",
  "projectType": "library",
  "tags": [
    "type:lib"
  ],
  "implicitDependencies": [
    "shared"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/libs/users"
      ],
      "options": {
        "command": "npx tsc -p libs/users/tsconfig.lib.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/users/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
