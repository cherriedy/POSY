{
  "name": "ingredients",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ingredients/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/ingredients"],
      "options": {
        "command": "npx tsc -p libs/ingredients/tsconfig.lib.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/ingredients/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
