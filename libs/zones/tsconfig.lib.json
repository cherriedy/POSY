{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "declaration": true,
    "types": [
      "node"
    ],
    "rootDir": "../../",
    "paths": {
      "@posy/shared": [
        "dist/libs/shared/src"
      ],
      "@posy/auth": [
        "libs/auth/src/index.ts"
      ],
      "@posy/auth/*": [
        "libs/auth/src/*"
      ],
      "@posy/users": [
        "libs/users/src/index.ts"
      ],
      "@posy/users/*": [
        "libs/users/src/*"
      ],
      "@posy/zones": [
        "libs/zones/src/index.ts"
      ],
      "@posy/zones/*": [
        "libs/zones/src/*"
      ],
      "@posy/floors": [
        "libs/floors/src/index.ts"
      ],
      "@posy/floors/*": [
        "libs/floors/src/*"
      ],
      "@posy/tables": [
        "libs/tables/src/index.ts"
      ],
      "@posy/tables/*": [
        "libs/tables/src/*"
      ],
      "src/*": [
        "apps/api/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
