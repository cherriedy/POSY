{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "declaration": true,
    "types": ["node"],
    "rootDir": "../../",
    "paths": {
      "@posy/shared": ["dist/libs/shared/src"],
      "@posy/auth": ["libs/auth/src/index.ts"],
      "src/*": ["apps/api/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
