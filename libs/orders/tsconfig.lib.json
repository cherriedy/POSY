{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "declaration": true,
    "types": ["node"],
    "rootDir": "../../",
    "paths": {
      "@posy/shared": ["dist/libs/shared/src"],
      "@posy/auth": ["libs/auth/src/index.ts"],
      "@posy/auth/*": ["libs/auth/src/*"],
      "@posy/users": ["libs/users/src/index.ts"],
      "@posy/users/*": ["libs/users/src/*"],
      "@posy/products": ["libs/products/src/index.ts"],
      "@posy/products/*": ["libs/products/src/*"],
      "@posy/orders": ["libs/orders/src/index.ts"],
      "@posy/orders/*": ["libs/orders/src/*"],
      "src/*": ["apps/api/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
