# Application
APP_ENV=development
APP_NAME=POSY
APP_PORT=3000
APP_URL=http://localhost:3000
APP_UPLOAD_DIR=uploads
APP_FRONTEND_CLIENT_URL=http://localhost:5173
APP_FRONTEND_ADMIN_URL=http://localhost:5174

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# JWT
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_TABLE_SESSION_SECRET=your_jwt_table_session_secret

# MailerSend
MAILERSEND_API_KEY=your_mailersend_api_key
MAILERSEND_FROM=noreply@yourdomain.com

# MeiliSearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your_meilisearch_master_key

# MoMo Payment
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_REDIRECT_URL=http://localhost:3000/payment/momo/redirect
MOMO_IPN_URL=http://localhost:3000/payment/momo/ipn

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883

# Python ML Service
PYTHON_URL=http://localhost:8000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
